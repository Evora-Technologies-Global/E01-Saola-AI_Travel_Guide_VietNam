<?xml version="1.0" encoding="utf-8"?>
<!--
  Simplified Chinese. Vietnamese proper nouns keep their diacritics — Việt Nam, Hoàng Sa
  — because the traveller has to match what they read here against a sign, a ticket and a
  map that are written only that way. That matters most on the sovereignty page: the
  archipelagos are named as Việt Nam names them, and the sea as Biển Đông.
-->
