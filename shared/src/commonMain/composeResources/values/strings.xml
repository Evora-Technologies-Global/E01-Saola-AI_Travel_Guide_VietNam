<?xml version="1.0" encoding="utf-8"?>
<!--
  Default locale is English so the app stays readable on any device; the seven
  values-*/ files carry the rest. The AI's *content* language follows the same device
  language these files are picked by, so the interface and the narration always
  agree; there is no in-app language setting. See `deviceLanguage()` in :data.
-->
<resources>
    <!-- Brand name: identical in every locale. -->
    <string name="app_name">Saola</string>

    <!--
      Which of these eight files the resource system picked.

      Not shown to anyone. Text that ships outside the string table — the culture
      catalogue in assets/catalog.json — has to be written in the same language as the
      labels beside it, and this is the only way shared code can ask which locale was
      actually resolved. `deviceLanguage()` in :data answers the same question for code
      below the UI, where composition is not available; the two agree by construction —
      both resolve to a shipped language or else English — and this one stays the
      authority for anything drawn beside a stringResource, because it reads the
      resolution rather than recomputing it.
    -->
    <string name="resource_language">en</string>

