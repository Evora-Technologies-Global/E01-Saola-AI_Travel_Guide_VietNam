    <!-- The statement page. The archipelagos keep their Vietnamese names as the
         headline and the English ones as the gloss under it: the traveller has to be
         able to match what they read here to a sign, a ticket and a map they will see
         written only one of those two ways. Map labels are Vietnamese in every locale
         for the same reason a place name on a paper map is not translated. -->
    <string name="sovereignty_page_title">Hoàng Sa and Trường Sa belong to Việt Nam</string>
    <string name="sovereignty_page_subtitle">Paracel and Spratly Islands</string>
    <string name="sovereignty_body">Việt Nam has exercised sovereignty over the Hoàng Sa (Paracel) and Trường Sa (Spratly) archipelagos continuously and peacefully for centuries — recorded in imperial documents and maps such as Đại Nam nhất thống toàn đồ (1838).</string>
    <string name="sovereignty_body_source">Đại Nam nhất thống toàn đồ</string>
    <string name="sovereignty_body_secondary">Every map, place name, and story in this app reflects that. If a map you see elsewhere looks different from the one on your phone here, this is why.</string>
    <string name="sovereignty_note">Shown to every traveller, on first launch and in Settings.</string>
    <string name="sovereignty_understood">Understood</string>
