<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Only the pre-Compose window shell. The activity draws edge to edge and hands
      the window over to Compose immediately, so this theme just has to avoid a
      flash of the wrong colour and an unwanted action bar during startup.
      values-night/ carries the dark variant.
    -->
    <style name="Theme.Saola" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.Saola.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Saola</item>
    </style>
</resources>
