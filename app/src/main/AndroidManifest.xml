<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      Coarse location is enough to tell Hà Nội from Hội An, which is all the
      prompt needs; fine location only sharpens disambiguation between two
      temples on the same street.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <!-- The lens switch hides itself when there is no front camera, so it must not
         become an install requirement. -->
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

    <!-- Needed on Android 11+ so the narration engine can find an installed voice; without
         the query TextToSpeech resolves nothing and reads nothing aloud. The companion
         RecognitionService query went with the voice-input branch on 02.08.2026. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".SaolaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saola"
        tools:targetApi="31">

        <!--
          The Maps SDK key for the Explore map, substituted from local.properties at
          build time so it never reaches version control. Enable "Maps SDK for Android"
          on the key; the Places calls use a separate key of their own, because this one
          should be restricted to this app's package and signing certificate and a
          package-restricted key is rejected by the Places REST endpoint.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!--
          Lets a report leave with the photograph it is about. The capture lives in
          `filesDir/captures`, which no other app can read, and a `file://` URI pointing
          into it has thrown FileUriExposedException since Android 7 — so the mail app is
          handed a content:// URI plus a read grant that lasts only as long as the activity
          it was started with.

          The authority is derived from `applicationId` rather than typed, because
          `rememberMailSharer` builds the same string from `context.packageName` at runtime
          and the two failing to match is a crash at the moment of sending, not at build time.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Saola.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
